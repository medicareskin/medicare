# Always canonicalize to the verified production domain.
NEXT_PUBLIC_SITE_URL=https://www.medicareskin.com
# IMPORTANT: only set true on the actual production deployment after QA.
NEXT_PUBLIC_ALLOW_INDEXING=false
# Display only genuine clinic-approved treatment names and devices.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional operations alert; do not include detailed medical concerns.
RESEND_API_KEY=
OPERATIONS_EMAIL=
FROM_EMAIL=

# Optional consent-gated analytics (no medical details).
NEXT_PUBLIC_GA4_ID=

# Rate limiting is mandatory for accepting production bookings.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_HASH_SECRET=
